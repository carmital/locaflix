# ============================================================================
# Locaflix Monorepo .gitignore
# ============================================================================

# Java / Maven / Spring Boot (server/)
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# SQLite Database & Runtime Scratch / Transcoding Files
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
scratch/
*.m3u8
*.ts
*.m4s

# Local Media Storage
media/

# Node / TypeScript / Workspaces (packages/*, apps/*, e2e/)
node_modules/
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
.npm
.eslintcache
.vite/
.turbo/

# React Native / Expo (apps/mobile, apps/tv)
.expo/
ios/Pods/
ios/build/
android/.gradle/
android/app/build/
android/build/
android/local.properties
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.ipa
*.apk
*.aab

# Playwright & E2E Artifacts (e2e/)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Environment & Secrets
.env
.env.local
.env.*.local

# IDEs & OS
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
